            },
            "afterResponseScript": "const jsonBody = insomnia.response.json();\n\nif (jsonBody && jsonBody.token) {\n    insomnia.environment.set('token', jsonBody.token);\n}\n\nif (jsonBody && jsonBody.user && jsonBody.user.id) {\n    insomnia.environment.set('user_id', jsonBody.user.id);\n}"
        },
        {
            "_id": "fld_category",
            "_type": "request_group",
            "parentId": "wrk_prisma",
            "name": "Category",
            "description": "(Precisa de Authorization: Bearer {{ _.token }})",
            "preRequestScript": "const atob = require('atob');\n\nconst jwtWillExpireSoon = (token, skewSeconds = 60) => {\n    if (!token || typeof token !== 'string') return true;\n\n    const parts = token.split('.');\n    if (parts.length !== 3) return true;\n\n    try {\n        const payloadB64 = parts[1].replace(/-/g, '+').replace(/_/g, '/');\n        const json = atob(payloadB64);\n        const payload = JSON.parse(json);\n\n        if (!payload || typeof payload.exp !== 'number') return true;\n\n        const nowSeconds = Math.floor(Date.now() / 1000);\n        return (payload.exp - nowSeconds) <= skewSeconds;\n    } catch (e) {\n        return true;\n    }\n};\n\nconst baseUrl = insomnia.environment.get('base_url');\nconst email = insomnia.environment.get('auth_email');\nconst password = insomnia.environment.get('auth_password');\nconst currentToken = insomnia.environment.get('token');\n\nif (!baseUrl || !email || !password) {\n    return;\n}\n\nif (!jwtWillExpireSoon(currentToken, 60)) {\n    return;\n}\n\nconst loginResponse = await new Promise((resolve, reject) => {\n    insomnia.sendRequest(\n        {\n            url: `${baseUrl}/api/Auth`,\n            method: 'POST',\n            headers: { 'Content-Type': 'application/json' },\n            body: { mimeType: 'application/json', text: JSON.stringify({ email, password }) },\n        },\n        (err, resp) => (err ? reject(err) : resolve(resp))\n    );\n});\n\nlet jsonBody = null;\ntry {\n    jsonBody = loginResponse?.body ? JSON.parse(loginResponse.body) : null;\n} catch (e) {\n    jsonBody = null;\n}\n\nif (jsonBody?.token) {\n    insomnia.environment.set('token', jsonBody.token);\n}\n\nif (jsonBody?.user?.id) {\n    insomnia.environment.set('user_id', jsonBody.user.id);\n}"
        },
